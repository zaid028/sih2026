# Server Network Settings
PORT=5000
HOST=127.0.0.1
DEBUG=false

# Demo Mode (Set to false to query live NASA FIRMS satellite data)
DEMO_MODE=false

# NASA FIRMS API (Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_API_KEY=f1cef81cb808845243d1b50eac115f6f
FIRMS_MAP_KEY=f1cef81cb808845243d1b50eac115f6f
FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT
FIRMS_DEFAULT_COUNTRY=IND

# OpenStreetMap Overpass API
OSM_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Database (Default uses zero-setup SQLite; or provide PostgreSQL + PostGIS)
DATABASE_URL=sqlite:///backend/data/fireguard.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fireguard_postgis

# JWT Authentication Secret
JWT_SECRET=fireguard_tactical_jwt_secret_sih2026_key_secure_99
SECRET_KEY=fireguard_tactical_jwt_secret_sih2026_key_secure_99
